%% 3. Curated data: incidents, media, oil flow, map. Every change is a reviewed PR. Source of 03-curated-data.svg.
%% Edge labels: WHAT · FORMAT · TRIGGER/CADENCE · AUTH
%% Node outline: thick blue dashed = in open PR #3 (not merged) · grey dotted = planned
%% Line: solid = automated · dotted = manual step by a person or a Claude thread
%% Red dashed boxes = trust boundaries. Render: docs/architecture/render.sh
flowchart LR
  subgraph IN["Inputs"]
    direction TB
    OFF[("Incident reporting<br/>UKMTO warnings, JMIC advisory notes,<br/>Windward, gCaptain, Reuters, Wikipedia")]
    JS["Jacob: UKMTO weekly dashboard screenshots<br/>PNG · only public source of deg-min positions"]
    JX["Jacob: X posts, WGOWS videos"]
    EIA[("EIA STEO + World Oil<br/>Transit Chokepoints")]
    NE[("Natural Earth 1:10m land<br/>npm world-atlas@2.0.2")]
  end

  subgraph WS["TRUST ZONE: Claude project workspace (private, outside the repo)"]
    direction TB
    CL["Claude research threads<br/>web search + reading"]
    AJ[("_build/agent_*.json<br/>findings per period")]
    GN[("geonamescache<br/>offline GeoNames")]
    BP["_build/march.py, fixups.py, build.py<br/>merge, dedupe, geocode bearings, enforce schema"]
    RT["Claude routine (planned)<br/>daily news search + weekly<br/>UKMTO / JMIC / EIA check"]
  end

  subgraph GH["GitHub"]
    direction TB
    PR["Pull request<br/>never auto-merged"]
    W3["validate.yml<br/>on pull_request + push to main"]
    S4["scripts/validate.mjs<br/>headers, enums, dates, region box,<br/>IMO = 7 digits, every incident has a source<br/>exit 1 = red check"]
    S5["scripts/clip-land.mjs<br/>one-off, dev machine"]
    subgraph DATA["data/ on main (public)"]
      direction TB
      D7[("incidents.csv<br/>one row per vessel per event<br/>confidence: confirmed / reported / claimed")]
      D8[("incident_sources.csv<br/>source trail, 1..n per incident")]
      D11[("landmarks.csv<br/>place coords used to infer positions")]
      D6[("media.csv (PR #3)<br/>curated items + verification label")]
      D9[("flow_eia.csv<br/>mb/d by period")]
      D10[("land.json<br/>clipped coastline GeoJSON, 46 KB")]
    end
  end
  J(["Jacob<br/>reviewer + merger"])

  OFF -.->|"read · HTML/PDF · per research pass"| CL
  JS -.->|"uploaded in chat · PNG"| CL
  JX -.->|"links in chat · become confidence = claimed"| CL
  CL -.->|"structured findings · JSON"| AJ
  AJ -.->|"input"| BP
  GN -.->|"landmark coords"| BP
  BP -.->|"regenerated CSVs"| PR
  CL -.->|"curated media rows · CSV"| PR
  EIA -.->|"figures copied by hand when EIA publishes · CSV"| PR
  RT -.->|"planned: new rows with source URLs"| PR
  PR -->|"opens / updates · pull_request event"| W3
  W3 -->|"runs"| S4
  S4 -->|"status check · pass / fail"| PR
  J -.->|"reviews diff, merges when green"| PR
  PR -->|"merge to main"| D7 & D8 & D11 & D6 & D9
  NE -.->|"npm install · one-off"| S5
  S5 -.->|"write · GeoJSON MultiPolygon · committed by hand"| D10

  classDef ext fill:#e3eaf3,stroke:#5a6b80,color:#1b2430
  classDef human fill:#fbe8cc,stroke:#a8742a,color:#3a2a10
  classDef claude fill:#ebe3f6,stroke:#7a62a3,color:#2a2040
  classDef job fill:#d9efe0,stroke:#3d7a4f,color:#143020
  classDef script fill:#ffffff,stroke:#3d7a4f,color:#143020
  classDef data fill:#fff3c4,stroke:#8a6d1f,color:#2e2408
  classDef site fill:#e1ecf8,stroke:#2f5d8a,color:#10243a
  classDef secret fill:#f9d9d4,stroke:#b3261e,color:#3a120c,stroke-width:2px
  classDef pr3 stroke:#1f5fa8,stroke-width:3px,stroke-dasharray:8 4
  classDef planned fill:#f5f5f5,stroke:#999999,color:#666666,stroke-dasharray:2 3
  classDef note fill:#fff7d6,stroke:#c9a227,color:#3a2e08
  classDef zone fill:#fbf8fe,stroke:#b3261e,stroke-width:2px,stroke-dasharray:10 5,color:#b3261e
  class OFF,EIA,NE ext
  class JS,JX,J human
  class CL,AJ,GN,BP claude
  class PR,W3 job
  class S4,S5 script
  class D7,D8,D11,D6,D9,D10 data
  class RT planned
  class WS zone
  class D6 pr3
