%% Edge labels: what · format · cadence · auth. Shapes, colours and line styles: see 00-legend.mmd.
flowchart TB
  subgraph IN["Inputs"]
    OFF[("UKMTO warnings, JMIC notes,<br/>Windward, gCaptain, Reuters, Wikipedia")]
    JS(["Jacob · UKMTO weekly<br/>dashboard screenshots"])
    JX(["Jacob · X posts,<br/>WGOWS videos"])
    EIA[("EIA STEO +<br/>Transit Chokepoints")]
    NE[("Natural Earth 1:10m<br/>npm world-atlas")]
  end

  subgraph WS["TRUST ZONE · Claude workspace · private"]
    CL["Claude research threads"]
    AJ[("_build/agent_*.json")]
    GN[("geonamescache<br/>offline GeoNames")]
    BP["_build/build.py<br/>merge · dedupe · geocode · schema"]
    RT["Claude routine<br/>daily news + weekly reports"]
  end

  S5["scripts/clip-land.mjs<br/>one-off, local"]

  subgraph GH["GitHub"]
    PR["pull request<br/>never auto-merged"]
    W3["validate.yml"]
    S4["validate.mjs<br/>headers · enums · dates · region box ·<br/>IMO · every incident has a source"]
    J(["Jacob · reviews + merges"])
    subgraph DATA["data/ on main"]
      D7[("incidents.csv")]
      D8[("incident_sources.csv")]
      D11[("landmarks.csv")]
      D6[("media.csv")]
      D9[("flow_eia.csv")]
      D10[("land.json")]
    end
  end

  OFF -.->|"read · HTML/PDF"| CL
