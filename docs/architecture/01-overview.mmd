%% 1. Overview: trust zones and the main data path.
%% Mermaid source. Render with ./render.sh (ELK layout, right-angle edges).
%% Edge labels: what · format · cadence · auth. Shapes, colours and line styles: see 00-legend.mmd.
flowchart TB
  subgraph SRC["External data sources"]
    PW[("IMF PortWatch<br/>+ straits.live mirror<br/>free, no auth")]
    XA[("X API v2 · recent search<br/>pay-per-use, needs key")]
    GD[("GDELT DOC 2.0 API<br/>free, no key")]
    REP[("UKMTO, JMIC, EIA,<br/>trade press, Wikipedia")]
  end
  J(["Jacob<br/>owner · reviews + merges PRs"])

  subgraph Z1["TRUST ZONE 1 · GitHub Actions · secrets live only here"]
    PWJ["fetch-portwatch.yml<br/>daily 06:17 UTC"]
    SEC{{"secret<br/>X_BEARER_TOKEN"}}
    MEDIA["fetch-media.yml · every 6 h<br/>GDELT, then 1 X query (15 posts)"]
    VAL["validate.yml<br/>every PR + push to main"]
  end

  subgraph Z2["TRUST ZONE 2 · Claude workspace · private"]
    CL["Claude research threads<br/>+ _build/build.py"]
  end

  subgraph Z3["TRUST ZONE 3 · public repo · written by the bot or a merged PR"]
    SITE["static site code<br/>index.html · app.js · style.css"]
    DATA[("data/ on main<br/>CSV + JSON files<br/>= the whole database")]
  end

  subgraph Z4["TRUST ZONE 4 · public web · no secrets, no API keys"]
    PAGES[["GitHub Pages<br/>static hosting, no server code"]]
    subgraph BR["viewer's browser · one page, two views"]
      DASH["Dashboard<br/>charts · map · X feed · news"]
      MON["#monitor<br/>wall of embedded X posts"]
    end
  end
  XEMB[("X embed service<br/>platform.twitter.com<br/>public, no key")]

  PW -->|"tanker transits · JSON/CSV · no auth"| PWJ
  XA -->|"X posts + counts · JSON · Bearer key"| MEDIA
  GD -->|"news volume + articles · JSON · no key"| MEDIA
  SEC -->|"env var"| MEDIA
  REP -.->|"read · HTML/PDF"| CL
  J -.->|"screenshots · X links"| CL
  CL -.->|"pull request · CSV"| VAL
  PWJ -->|"git commit · CSV"| DATA
  MEDIA -->|"git commit · CSV/JSON"| DATA
  VAL -->|"green check · Jacob merges"| DATA
  SITE -->|"push to main · deploy"| PAGES
  DATA -->|"push to main · deploy"| PAGES
  PAGES -->|"HTML, JS, CSV · on load"| DASH
  PAGES -->|"x_posts.csv · every 10 min"| MON
  DASH <-->|"URL #monitor"| MON
  MON -->|"request embeds · JS + iframes · no key"| XEMB

