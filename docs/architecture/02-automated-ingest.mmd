%% 2. Automated ingest: the three scheduled GitHub Actions.
%% Mermaid source. Render with ./render.sh (ELK layout, right-angle edges).
%% Edge labels: what · format · cadence · auth. Shapes, colours and line styles: see 00-legend.mmd.
flowchart TB
  subgraph EXT["External APIs"]
    SL[("straits.live/data/transits.csv<br/>mirror of PortWatch")]
    PW[("IMF PortWatch FeatureServer<br/>Daily_Chokepoints_Data · chokepoint6")]
    TG[("Telegram t.me/s/&lt;channel&gt;<br/>20 public channels")]
    NW[("Google News RSS · 6 queries, 5 languages<br/>9 outlet RSS feeds<br/>straits.live data/events.csv")]
    GD[("GDELT DOC 2.0 API<br/>timelinevolraw · last 7 days<br/>often 429 to runners")]
    XA[("X API v2<br/>/2/tweets/search/recent<br/>≈ $0.005 per post read")]
  end

  subgraph RUN["TRUST ZONE · GitHub Actions runner · Node 22 · GITHUB_TOKEN contents:write"]
    W1["fetch-portwatch.yml<br/>cron 17 6 * * * · daily 06:17 UTC"]
    W2["fetch-media.yml<br/>cron 41 */6 * * * · every 6 h<br/>concurrency group data-commit"]
    W3["fetch-free.yml<br/>cron 23 * * * * · hourly<br/>concurrency group data-commit"]
    S4["fetch-telegram.mjs<br/>channels in free-feeds.json<br/>1-3 pages each · match.mjs filter<br/>keeps 30 days"]
    S5["fetch-news.mjs<br/>feeds in free-feeds.json<br/>match.mjs filter on outlet RSS<br/>dedup by headline · 7 days"]
    S2["fetch-gdelt.mjs<br/>1 request, 4 tries<br/>quiet exit on 429"]
    SEC{{"secret X_BEARER_TOKEN"}}
    QJ["x-queries.json<br/>15 queries · EN / AR / FA<br/>ships + civil infrastructure<br/>each with an engagement floor"]
    S1["fetch-portwatch.mjs<br/>6 tries per page, then mirror"]
    S3["fetch-x.mjs<br/>next query in rotation · 15 posts<br/>stops at 1,800 reads/month<br/>refuses a query without a floor"]
    subgraph WD["data/ in the runner's checkout"]
      D1[("transits_portwatch.csv")]
      D2[("coverage_gdelt.csv")]
      D3[("tg_posts.csv")]
      D6[("news.csv")]
      D4[("x_posts.csv")]
      D5[("x_budget.json<br/>reads · cap · next query")]
    end
    C1["commit step<br/>commit if changed · push"]
    C2["commit step<br/>commit if changed<br/>pull --rebase · push"]
    C3["commit step<br/>commit if changed<br/>pull --rebase · push"]
  end
  MAIN(["main branch · public<br/>push triggers Pages deploy"])

  W1 -->|"runs"| S1
  PW -->|"1st choice · JSON · no auth"| S1
  SL -.->|"fallback · CSV · no auth"| S1
