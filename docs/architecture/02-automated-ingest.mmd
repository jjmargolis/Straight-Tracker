%% 2. Automated ingest: GitHub Actions fetch jobs. Source of 02-automated-ingest.svg.
%% Edge labels: WHAT · FORMAT · TRIGGER/CADENCE · AUTH
%% Node outline: thick blue dashed = in open PR #3 (not merged) · grey dotted = planned
%% Line: solid = automated · dotted = manual step by a person or a Claude thread
%% Red dashed boxes = trust boundaries. Render: docs/architecture/render.sh
flowchart TB
  PW[("IMF PortWatch<br/>ArcGIS FeatureServer<br/>Daily_Chokepoints_Data<br/>portid chokepoint6 · 3-5 day lag")]
  SL[("straits.live<br/>/data/transits.csv<br/>daily mirror of PortWatch")]
  GD[("GDELT DOC 2.0 API<br/>timelinevolraw + artlist<br/>~3-month lookback")]
  XA[("X API v2<br/>GET /2/tweets/search/recent<br/>~$0.005 per post read")]

  subgraph RUN["TRUST ZONE: GitHub Actions runner · ubuntu-latest, Node 22 · GITHUB_TOKEN contents:write"]
    W1["fetch-portwatch.yml<br/>cron 17 6 * * * = 06:17 UTC daily<br/>+ workflow_dispatch"]
    S1["scripts/fetch-portwatch.mjs<br/>6 tries per page, 2 s x n backoff,<br/>then mirror"]
    C1["fetch-portwatch.yml commit step<br/>git add transits_portwatch.csv<br/>commit only if diff · push"]
    W2["fetch-media.yml (PR #3)<br/>cron 41 */6 * * * = every 6 h<br/>+ workflow_dispatch<br/>concurrency group data-commit"]
    SEC{{"secret X_BEARER_TOKEN<br/>repo Actions secret<br/>masked in logs"}}
    LIB["scripts/lib.mjs<br/>CSV parse + write, no deps<br/>imported by both fetch scripts"]
    S2["step 1: scripts/fetch-gdelt.mjs<br/>1 request per 6 s · back off on 429<br/>timeout 4 min · continue-on-error"]
    S3["step 2: scripts/fetch-x.mjs<br/>skips unless the 06:41 UTC run or manual<br/>50 posts per run · 1,800 per month cap"]
    C2["fetch-media.yml commit step<br/>git add data/ · commit if diff<br/>pull --rebase · push"]
  end

  subgraph DATA["data/ (public once pushed)"]
    D1[("transits_portwatch.csv<br/>date, n_tanker, n_total,<br/>capacity_tanker")]
    D2[("coverage_gdelt.csv<br/>date, articles, total")]
    D3[("gdelt_articles.csv<br/>latest 75 articles, 7 days")]
    D4[("x_posts.csv<br/>id, author, text, views, likes,<br/>reposts, preview, url<br/>max 2,000 rows")]
    D5[("x_budget.json<br/>month, reads, cap")]
  end

  MAIN(["main branch<br/>push triggers Pages build"])

  W1 -->|"starts"| S1
  PW -->|"1st choice · JSON · 1,000 rows/page · no auth"| S1
  SL -.->|"fallback · CSV · no auth · no capacity column"| S1
  S1 -->|"overwrite series · CSV"| D1
  D1 -->|"staged"| C1
  C1 -->|"git push · bot identity"| MAIN

  W2 -->|"starts step 1"| S2
  W2 -->|"starts step 2"| S3
  LIB -.- S2
  LIB -.- S3
  GD -->|"counts + article list · JSON · no key · max 1 req / 5 s"| S2
  SEC -->|"env var at runtime"| S3
  XA -->|"posts, metrics, authors, media · JSON · Bearer token · billed per post"| S3
  S2 -->|"merge by date · CSV"| D2
  S2 -->|"overwrite · CSV"| D3
  S3 -->|"merge by post id · CSV"| D4
  S3 <-->|"check, then add reads · JSON"| D5
  D2 & D3 & D4 & D5 -->|"staged"| C2
  C2 -->|"git push · bot identity"| MAIN
