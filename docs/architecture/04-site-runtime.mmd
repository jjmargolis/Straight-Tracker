%% 4. Site runtime: what a viewer's browser loads and does.
%% Mermaid source. Render with ./render.sh (ELK layout, right-angle edges).
%% Edge labels: what · format · cadence · auth. Shapes, colours and line styles: see 00-legend.mmd.
flowchart TB
  subgraph REPO["main branch · public repo"]
    CODE["index.html · style.css · app.js<br/>vendor/ d3 7.9.0 + Plot 0.6.17"]
    DATA[("data/ · 8 CSV + land.json")]
  end
  PAGES[["GitHub Pages<br/>static files · CDN cache ≈ 10 min"]]

  subgraph WEB["TRUST ZONE · public web · read-only, no secrets or keys"]
    subgraph BR["viewer's browser · one page"]
      APP["app.js<br/>loads all data once"]
      LS[("localStorage<br/>window · keywords · Videos only")]
      DASH["Dashboard (no hash)<br/>KPIs · X feed · news · coverage ·<br/>map · oil flow · transits · table"]
      MON["#monitor<br/>wall of X posts, videos first<br/>16 more on each scroll<br/>shows our link card until the embed loads"]
    end
  end

  subgraph X3["Third parties the browser contacts"]
    XCDN[("X media CDN<br/>preview images")]
    XEMB[("X embed service<br/>platform.twitter.com/widgets.js")]
  end

  CODE -->|"push · deploy"| PAGES
  DATA -->|"push · deploy"| PAGES
  PAGES -->|"HTTPS GET · on load"| APP
  LS -->|"saved settings"| APP
  APP -->|"render"| DASH
  APP -->|"render"| MON
  DASH -->|"setup bar"| LS
  DASH <-->|"URL #monitor"| MON
  MON -->|"every 10 min · x_posts.csv?t=now"| PAGES
  DASH -->|"img · no-referrer"| XCDN
  MON -->|"script once + 1 iframe per post · dnt"| XEMB

  classDef ext fill:#e3eaf3,stroke:#5a6b80,color:#1b2430
  classDef human fill:#fbe8cc,stroke:#a8742a,color:#3a2a10
  classDef claude fill:#ebe3f6,stroke:#7a62a3,color:#2a2040
  classDef job fill:#d9efe0,stroke:#3d7a4f,color:#143020
  classDef script fill:#ffffff,stroke:#3d7a4f,color:#143020
  classDef data fill:#fff3c4,stroke:#8a6d1f,color:#2e2408
  classDef site fill:#e1ecf8,stroke:#2f5d8a,color:#10243a
  classDef secret fill:#f9d9d4,stroke:#b3261e,color:#3a120c,stroke-width:2px
  classDef pending stroke:#1f5fa8,stroke-width:3px,stroke-dasharray:8 4
  classDef planned fill:#f5f5f5,stroke:#999999,color:#666666,stroke-dasharray:2 3
  classDef note fill:#fff7d6,stroke:#c9a227,color:#3a2e08
  classDef zone fill:#fffafa,stroke:#b3261e,stroke-width:2px,stroke-dasharray:10 5,color:#b3261e
  classDef group fill:#fafafa,stroke:#bbbbbb,color:#333333
  class XEMB,XCDN ext
  class CODE,PAGES,APP,DASH,MON site
  class DATA,LS data
  class WEB zone
  class REPO,BR,X3 group
