%% 4. Site runtime: what a browser loads and does. Source of 04-site-runtime.svg.
%% Edge labels: WHAT · FORMAT · TRIGGER/CADENCE · AUTH
%% Node outline: thick blue dashed = in open PR #3 (not merged) · grey dotted = planned
%% Line: solid = automated · dotted = manual step by a person or a Claude thread
%% Red dashed boxes = trust boundaries. Render: docs/architecture/render.sh
flowchart TB
  subgraph REPO["main branch (public repo)"]
    CODE["index.html · style.css · app.js<br/>vendor/d3 7.9.0 · vendor/Plot 0.6.17"]
    DATA[("data/<br/>incidents · incident_sources · flow_eia ·<br/>transits_portwatch · land.json · x_posts ·<br/>gdelt_articles · coverage_gdelt · media")]
  end

  subgraph WEB["TRUST ZONE: public web · read-only · no secrets, API keys or login"]
    PAGES[["GitHub Pages<br/>static hosting from main, root<br/>CDN cache ~10 min · not enabled yet"]]
    XCDN[("X media CDN<br/>post preview images")]
    XCOM["x.com and news sites<br/>open in a new tab on click"]
    subgraph BR["Viewer's browser (laptop or phone, landscape): ONE page"]
      APP["app.js (ES module)<br/>loads all data once, renders both views"]
      DASH["Dashboard view (URL without hash)<br/>monitor setup bar · KPIs · Most shared on X ·<br/>latest news · curated media · coverage chart ·<br/>incident map + detail · oil flow · transits ·<br/>incidents by month · incident table"]
      MON["#monitor view (PR #3)<br/>full screen · 4 independent scrolling columns:<br/>X most viewed · X latest · news · incidents<br/>every 10 min: refetch 3 files, re-render"]
      LS[("localStorage 'hormuz-monitor'<br/>time window, keywords, claims toggle<br/>this browser only")]
    end
  end

  CODE -->|"push to main · Pages build"| PAGES
  DATA -->|"push to main · Pages build"| PAGES
  PAGES -->|"HTTPS GET on load · HTML/JS/CSS + 8 CSV + 1 JSON · same origin"| APP
  LS -->|"restore settings · JSON"| APP
  APP -->|"render (no hash)"| DASH
  APP -->|"render (hash = #monitor)"| MON
  DASH -->|"save setup bar · JSON"| LS
  DASH <-->|"'Open monitor' sets #monitor · clicking an incident returns with its detail open"| MON
  MON -->|"HTTPS GET every 10 min · x_posts, gdelt_articles, incidents · ?t=now cache-buster"| PAGES
  XCDN -->|"img hotlink, no-referrer · the only third-party request"| DASH
  XCDN -->|"img hotlink"| MON
  DASH -->|"link out"| XCOM
  MON -->|"link out"| XCOM
